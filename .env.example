FOUNDRY_PROJECT_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/<project>
FOUNDRY_MODEL_NAME= your deployment name #(or the Model Router deployment)
FOUNDRY_ROUTER_NAME=your deployment name for the model-router
FOUNDRY_EMBEDDING_NAME=your deployment name for text-embedding
AZURE_EXPERIMENTAL_ENABLE_GENAI_TRACING=true #required opt-in for client-side tracing
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=false #leave off unless you want prompts in traces (dev only)

HOSTED_AGENT_NAME=demo-hosted-agent
LONG_RUNNING_AGENT_NAME=demo-long-running-agent

# Notebook 5 only: A2A connection, calling agent, and the agent exposed over A2A.
FOUNDRY_A2A_CONNECTION=claims-triage-a2a
FOUNDRY_AGENT_NAME=concierge-agent
FOUNDRY_A2A_TARGET_AGENT=claims-triage-foundry

# Notebook 1: ARM IDs for the Foundry project (AZURE_SUBSCRIPTION_ID / AZURE_RESOURCE_GROUP are defined in the gateway section below).
# Account and project names default to the ones in FOUNDRY_PROJECT_ENDPOINT; set these only to override.
# FOUNDRY_ACCOUNT_NAME=<foundry-account>
# FOUNDRY_PROJECT_NAME=<project>

APP_INSIGHTS_RESOURCE_ID=/subscriptions/YOUR-SUBSCRIPTION-ID/resourceGroups/YOUR-RESOURCE-GROUP/providers/Microsoft.Insights/components/YOUR-APP-INSIGHTS-NAME

# Notebook 3 only: independent private infrastructure inputs.
PRIVATE_DEMO_SUBSCRIPTION_ID=<subscription-id>
PRIVATE_DEMO_RESOURCE_GROUP=rg-foundry-private-teams-demo
PRIVATE_DEMO_LOCATION=switzerlandnorth
PRIVATE_DEMO_ACCOUNT_BASE=foundryteams
PRIVATE_DEMO_PROJECT_BASE=teams
PRIVATE_DEMO_VNET_NAME=private-teams-vnet
PRIVATE_DEMO_MODEL_NAME=gpt-4.1
PRIVATE_DEMO_MODEL_VERSION=2025-04-14
PRIVATE_DEMO_MODEL_SKU=GlobalStandard
PRIVATE_DEMO_MODEL_CAPACITY=10
PRIVATE_DEMO_VNET_PREFIX=10.74.0.0/16
PRIVATE_DEMO_AGENT_SUBNET_PREFIX=10.74.0.0/24
PRIVATE_DEMO_PE_SUBNET_PREFIX=10.74.1.0/24
PRIVATE_DEMO_AZD_ENV=private-teams-demo
PRIVATE_DEMO_DEPLOYMENT_NAME=private-teams-infra
# Optional tenant-member user object ID; blank uses the signed-in Azure CLI user.
PRIVATE_DEMO_PRINCIPAL_ID=

# Notebook 6 only: Content Understanding.
CONTENTUNDERSTANDING_ENDPOINT=https://<resource>.services.ai.azure.com/
# CONTENTUNDERSTANDING_KEY=        # blank uses Entra ID; needs Cognitive Services User on the resource
CU_COMPLETION_MODEL=gpt-5.2
CU_EMBEDDING_MODEL=text-embedding-3-large
# CU_COMPLETION_DEPLOYMENT=gpt-5.2
# CU_EMBEDDING_DEPLOYMENT=text-embedding-3-large
# Blank downloads samples to ./sample_files/.
# CU_SAMPLE_DOC_PATH=./sample_files/sample_invoice.pdf
# CU_MIXED_BATCH_PATH=./sample_files/mixed_financial_docs.pdf
# CU_AGENTIC_DOC_PATH=./sample_files/workflow_invoice_20_items.pdf

# Notebook 7 only: Voice Live (Entra ID only; also uses FOUNDRY_PROJECT_ENDPOINT).
AZURE_VOICELIVE_ENDPOINT=https://<resource>.services.ai.azure.com/
FOUNDRY_PROJECT_NAME=<project>
FOUNDRY_TEXT_MODEL_DEPLOYMENT=<text model deployment for the step 6 agent>
VOICELIVE_REALTIME_MODEL=gpt-realtime
VOICELIVE_TEXT_MODEL=gpt-4.1-mini
VOICE_AGENT_MODEL=gpt-realtime

# AI gateway governance notebook only (also uses FOUNDRY_PROJECT_ENDPOINT). Keys below are secrets.
AZURE_SUBSCRIPTION_ID=<subscription-guid>
AZURE_RESOURCE_GROUP=<resource-group-of-apim>
APIM_SERVICE_NAME=<apim-name>
# Base URL only here; notebook 2 expects the API suffix appended (https://<apim>.azure-api.net/<suffix>).
APIM_GATEWAY_URL=https://<apim-name>.azure-api.net
APIM_ARM_API_VERSION=2024-06-01-preview
INFERENCE_API_ID=<api-id-as-listed-in-step-0>
INFERENCE_API_PATH=<api-url-suffix>
INFERENCE_API_STYLE=v1                    # v1 = /openai/v1/... ; azure = /openai/deployments/{name}/...
INFERENCE_API_VERSION=2025-03-01-preview  # used only when INFERENCE_API_STYLE=azure
SUBSCRIPTION_KEY_HEADER=api-key           # or Ocp-Apim-Subscription-Key, as configured on the API
CHAT_DEPLOYMENT=gpt-4.1-mini
BASELINE_SUBSCRIPTION_KEY=                # optional: empty uses the built-in all-access subscription key
FOUNDRY_RESOURCE_ENDPOINT=https://<foundry-resource>.cognitiveservices.azure.com
EMBEDDINGS_DEPLOYMENT=text-embedding-3-small
SECONDARY_FOUNDRY_ENDPOINT=               # optional: second resource with the same deployment name
CONTENT_SAFETY_ENDPOINT=https://<content-safety-or-foundry-resource>.cognitiveservices.azure.com
REDIS_CONNECTION_STRING=<host>:10000,password=<key>,ssl=True,abortConnect=False   # Azure Managed Redis with RediSearch
APPINSIGHTS_RESOURCE_ID=/subscriptions/<sub>/resourceGroups/<rg>/providers/Microsoft.Insights/components/<name>
APPINSIGHTS_INSTRUMENTATION_KEY=<instrumentation-key>
APPLICATIONINSIGHTS_CONNECTION_STRING=<connection-string>
LOG_ANALYTICS_WORKSPACE_RESOURCE_ID=/subscriptions/<sub>/resourceGroups/<rg>/providers/Microsoft.OperationalInsights/workspaces/<name>
LOG_ANALYTICS_WORKSPACE_ID=<workspace-guid>
LOG_LLM_MESSAGES=false                    # true records prompts and completions in Log Analytics
MCP_API_ID=                               # optional, step 7
MCP_URL=                                  # https://<apim-name>.azure-api.net/<path>/mcp
MCP_SUBSCRIPTION_KEY=
A2A_API_ID=                               # optional, step 8a
A2A_RPC_URL=
A2A_AGENT_CARD_URL=
A2A_SUBSCRIPTION_KEY=
APIM_CONNECTION_NAME=                     # optional, step 8b: API Management connection in the project
FOUNDRY_GATEWAY_CHAT_URL=                 # optional, step 9 (preview): project gateway chat-completions URL
FOUNDRY_GATEWAY_KEY=
FOUNDRY_GATEWAY_KEY_HEADER=api-key

